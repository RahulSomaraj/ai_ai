// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// FOUNDATION ENTITIES (Academic Structure)
// ============================================

model Subject {
  id        String   @id @default(uuid())
  name      String // e.g., "Physics"
  class     Int // e.g., 11
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  textbooks    Textbook[]
  units        Unit[]
  chatSessions ChatSession[]

  // Indexes for common queries
  @@index([name, class])
  @@map("subjects")
}

model Textbook {
  id        String   @id @default(uuid())
  subjectId String
  title     String // e.g., "Physics Part 1"
  code      String? // e.g., "PH11-P1" (optional identifier)
  order     Int // Order within subject (1, 2, 3...)
  source    String   @default("NCERT") // e.g., "NCERT", "State Board"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  subject      Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  chatSessions ChatSession[]

  @@unique([subjectId, order])
  // Indexes
  @@index([subjectId, order])
  @@map("textbooks")
}

// ============================================
// SYLLABUS (Frozen policy: units & topics)
// ============================================
// Syllabus is now first-class in Postgres and scoped to a Subject
// (subject name + class). Units group topics; topics carry learning
// outcomes and become the retrieval-control unit for RAG.

model Unit {
  id        String   @id @default(uuid())
  subjectId String   @map("subject_id")
  code      String // syllabus unit id, e.g. "PHY_U1"
  name      String // e.g. "Units and Measurement"
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topics  Topic[]

  @@unique([subjectId, code])
  @@index([subjectId])
  @@map("units")
}

model Topic {
  id               String   @id @default(uuid())
  unitId           String   @map("unit_id")
  code             String // syllabus topic id, e.g. "PHY_U1_T1"
  name             String // e.g. "Significant Figures"
  learningOutcomes String[] @default([]) @map("learning_outcomes")
  order            Int      @default(0)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  unit      Unit            @relation(fields: [unitId], references: [id], onDelete: Cascade)
  chunks    RagChunk[]
  embedding TopicEmbedding?

  @@unique([unitId, code])
  @@index([unitId])
  @@map("topics")
}

model TopicEmbedding {
  topicId   String                      @id @map("topic_id")
  embedding Unsupported("vector(1536)")
  model     String
  createdAt DateTime                    @default(now()) @map("created_at")

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@map("topic_embeddings")
}

// ============================================
// RAG CONTENT (Documents, chunks, embeddings)
// ============================================

model RagDocument {
  id         String   @id @default(uuid())
  title      String
  subject    String
  classLevel Int      @map("class_level")
  chapter    String
  exercise   String?
  sourceType String   @default("ncert_book") @map("source_type")
  sourcePath String?  @map("source_path")
  createdAt  DateTime @default(now()) @map("created_at")

  chunks RagChunk[]

  @@index([subject, classLevel, chapter])
  @@map("documents")
}

model RagChunk {
  id         String   @id @default(uuid())
  documentId String   @map("document_id")
  chunkIndex Int      @map("chunk_index")
  content    String
  tokenCount Int      @map("token_count")
  pageNo     Int?     @map("page_no")
  section    String?
  topicId    String?  @map("topic_id")
  createdAt  DateTime @default(now()) @map("created_at")

  document  RagDocument        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  topic     Topic?             @relation(fields: [topicId], references: [id], onDelete: SetNull)
  embedding RagChunkEmbedding?

  @@index([documentId, chunkIndex])
  @@index([topicId])
  @@map("chunks")
}

model RagChunkEmbedding {
  chunkId   String                      @id @map("chunk_id")
  embedding Unsupported("vector(1536)")
  model     String
  createdAt DateTime                    @default(now()) @map("created_at")

  chunk RagChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@map("chunk_embeddings")
}

// ============================================
// CHAT HISTORY (Sessions and Q&A turns)
// ============================================
// A session is one conversation (one row in the "recent history" list).
// Each message is one question + its RAG answer (one turn in the chat view).

model ChatSession {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  title         String // first ~60 chars of the opening question
  subjectId     String?   @map("subject_id")
  textbookId    String?   @map("textbook_id")
  classLevel    Int       @map("class_level")
  sourceType    String?   @map("source_type") // e.g. "ncert_book", "scert_kerala_book"
  lastMessageAt DateTime  @default(now()) @map("last_message_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at") // soft delete

  subject  Subject?      @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  textbook Textbook?     @relation(fields: [textbookId], references: [id], onDelete: SetNull)
  messages ChatMessage[]

  @@index([userId, lastMessageAt(sort: Desc)])
  @@map("chat_sessions")
}

model ChatMessage {
  id                 String   @id @default(uuid())
  sessionId          String   @map("session_id")
  question           String
  standaloneQuestion String?  @map("standalone_question") // follow-up rewritten for retrieval
  answer             String
  status             String // "answered" | "no_context" | "out_of_scope"
  citations          Json     @default("[]")
  confidence         Float    @default(0)
  fallback           Boolean  @default(false)
  createdAt          DateTime @default(now()) @map("created_at")

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}
